            "dependencies": { "minecraft": "1.21.1", "fabric-loader": "0.16.10" }
          },
          "overrides/config/example.toml": "enabled = true\n"
        }
      },
      "game": "minecraft",
      "target": { "game_version": "1.21.1", "loader": "fabric", "loader_version": "0.16.10", "side": "client" }
    },
