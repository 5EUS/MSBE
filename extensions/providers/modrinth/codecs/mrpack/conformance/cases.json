              },
              {
                "path": "resourcepacks/optional.zip",
                "downloads": ["https://cdn.example.test/optional.zip"],
                "hashes": { "sha512": "dd" },
                "env": { "client": "optional", "server": "optional" }
              },
              {
                "path": "mods/server-only.jar",
