<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
  Application-wide styles live here rather than in individual views, so a visual
  change is one file and one review.
  -->
  <Style Selector="TextBlock.sectionHeading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.shell-header">
    <Setter Property="Background" Value="#17191F" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="Foreground" Value="#D6D9E0" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.header-context">
    <Setter Property="Foreground" Value="#D6D9E0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="Button.command-button">
    <Setter Property="Background" Value="#3A5874" />
    <Setter Property="Foreground" Value="#F2F4F8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="#1C1F27" />
    <Setter Property="BorderBrush" Value="#343946" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="TextBlock.sidebar-label">
    <Setter Property="Foreground" Value="#99A1B3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="Button.nav-button">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D6D9E0" />
  </Style>

  <Style Selector="Button.nav-button:pointerover">
    <Setter Property="Background" Value="#2B303B" />
  </Style>

  <Style Selector="Border.shell-header MenuItem">
    <Setter Property="Foreground" Value="#D6D9E0" />
  </Style>

  <Style Selector="Border.sidebar TextBox">
    <Setter Property="Background" Value="#272C36" />
    <Setter Property="Foreground" Value="#F2F4F8" />
    <Setter Property="BorderBrush" Value="#414858" />
  </Style>

  <Style Selector="Border.sidebar ComboBox">
    <Setter Property="Background" Value="#272C36" />
    <Setter Property="Foreground" Value="#F2F4F8" />
  </Style>

  <Style Selector="Border.sidebar ListBox">
    <Setter Property="Background" Value="#1C1F27" />
    <Setter Property="Foreground" Value="#D6D9E0" />
  </Style>

  <Style Selector="Border.workspace">
    <Setter Property="Background" Value="#232731" />
    <Setter Property="Padding" Value="28" />
  </Style>

  <Style Selector="Border.workspace TextBlock">
    <Setter Property="Foreground" Value="#E8EAF0" />
  </Style>

  <Style Selector="Border.status-bar">
    <Setter Property="Background" Value="#17191F" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <Style Selector="Border.status-bar TextBlock">
    <Setter Property="Foreground" Value="#AEB5C3" />
  </Style>

  <Style Selector="Border.cli-scrim">
    <Setter Property="Background" Value="#AA090A0E" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="36" />
  </Style>

  <Style Selector="Border.cli-popup">
    <Setter Property="Background" Value="#1C1F27" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.cli-popup TextBlock">
    <Setter Property="Foreground" Value="#F2F4F8" />
  </Style>

  <Style Selector="TextBox.cli-output">
    <Setter Property="MinHeight" Value="260" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Monospace" />
  </Style>
</Styles>
