<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
  Application-wide styles live here rather than in individual views, so a visual
  change is one file and one review.
  -->
  <Style Selector="TextBlock.sectionHeading">
    <Setter Property="Foreground" Value="#F3F4F6" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="#8D94A3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.shell-header">
    <Setter Property="Background" Value="#0E1014" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0,0,0" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="Foreground" Value="#F0F2F5" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.header-context">
    <Setter Property="Foreground" Value="#8D94A3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.command-button">
    <Setter Property="Background" Value="#20242C" />
    <Setter Property="Foreground" Value="#D8DCE4" />
    <Setter Property="BorderBrush" Value="#343A46" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption-button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="35" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B8BEC9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption-button:pointerover">
    <Setter Property="Background" Value="#292E38" />
    <Setter Property="Foreground" Value="#F3F4F6" />
  </Style>

  <Style Selector="Button.caption-button.close:pointerover">
    <Setter Property="Background" Value="#C42B3A" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.primary-button">
    <Setter Property="Background" Value="#285C78" />
    <Setter Property="Foreground" Value="#F7FAFC" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.secondary-button">
    <Setter Property="Background" Value="#20242C" />
    <Setter Property="Foreground" Value="#D8DCE4" />
    <Setter Property="BorderBrush" Value="#343A46" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.danger-button">
    <Setter Property="Background" Value="#3A2025" />
    <Setter Property="Foreground" Value="#F1C4CC" />
    <Setter Property="BorderBrush" Value="#713E48" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="#121419" />
    <Setter Property="BorderBrush" Value="#252933" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="TextBlock.sidebar-label">
    <Setter Property="Foreground" Value="#737B8C" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.workspace-tabs">
    <Setter Property="Background" Value="#0E1014" />
    <Setter Property="BorderBrush" Value="#242832" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,0" />
  </Style>

  <Style Selector="Button.workspace-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#8D94A3" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="2,10,2,8" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Button.workspace-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="#F3F4F6" />
  </Style>

  <Style Selector="Button.workspace-tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.workspace-tab.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="BorderBrush" Value="#72C6A5" />
  </Style>

  <Style Selector="Border.shell-header MenuItem">
    <Setter Property="Foreground" Value="#C9CED8" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="Border.sidebar TextBox">
    <Setter Property="Background" Value="#191C22" />
    <Setter Property="Foreground" Value="#E4E7EC" />
    <Setter Property="BorderBrush" Value="#303540" />
  </Style>

  <Style Selector="Border.sidebar ComboBox">
    <Setter Property="Background" Value="#191C22" />
    <Setter Property="Foreground" Value="#E4E7EC" />
    <Setter Property="BorderBrush" Value="#303540" />
  </Style>

  <Style Selector="Border.sidebar ListBox">
    <Setter Property="Background" Value="#15181D" />
    <Setter Property="Foreground" Value="#C9CED8" />
    <Setter Property="BorderBrush" Value="#292E38" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.workspace">
    <Setter Property="Background" Value="#171A20" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.workspace TextBlock">
    <Setter Property="Foreground" Value="#E4E7EC" />
  </Style>

  <Style Selector="Border.error-banner">
    <Setter Property="Background" Value="#27191C" />
    <Setter Property="BorderBrush" Value="#713E48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.instance-detail-panel">
    <Setter Property="Background" Value="#1B1E25" />
    <Setter Property="BorderBrush" Value="#303540" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="22" />
  </Style>

  <Style Selector="TextBlock.instance-name">
    <Setter Property="Foreground" Value="#F3F4F6" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.detail-label">
    <Setter Property="Foreground" Value="#737B8C" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="Foreground" Value="#8D94A3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.mods-error">
    <Setter Property="Background" Value="#27191C" />
    <Setter Property="BorderBrush" Value="#713E48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9" />
  </Style>

  <Style Selector="ListBox.mods-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="ListBox.mods-list ListBoxItem">
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="Margin" Value="3,3,3,0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="ListBox.mods-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="#20242C" />
  </Style>

  <Style Selector="Border.mod-icon">
    <Setter Property="Background" Value="#263640" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.mod-icon LucideIcon">
    <Setter Property="Foreground" Value="#9FC9BA" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.mod-search-icon">
    <Setter Property="Background" Value="#263640" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="Border.mod-search-icon LucideIcon">
    <Setter Property="Foreground" Value="#9FC9BA" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBox.preview-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.preview-list ListBoxItem">
    <Setter Property="Padding" Value="11,8" />
  </Style>

  <Style Selector="TextBlock.operation-marker">
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBox.browse-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.browse-list ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.browse-detail">
    <Setter Property="Background" Value="#1B1E25" />
    <Setter Property="BorderBrush" Value="#303540" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="TextBlock.provider-label">
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ListBox.profile-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.profile-list ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="ListBox.games-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.games-list ListBoxItem">
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="ListBox.pack-config-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ListBox.pack-config-list ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
  </Style>

  <Style Selector="TextBox.config-editor">
    <Setter Property="Background" Value="#0C0E12" />
    <Setter Property="Foreground" Value="#DCE1E8" />
    <Setter Property="BorderBrush" Value="#292E38" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.ecosystem-badge">
    <Setter Property="Background" Value="#263640" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style Selector="ListBox.game-search-list">
    <Setter Property="Background" Value="#14171C" />
    <Setter Property="BorderBrush" Value="#2C313C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="ListBox.game-search-list ListBoxItem">
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Margin" Value="3,3,3,0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="ListBox.game-search-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="#20242C" />
  </Style>

  <Style Selector="Border.game-search-ecosystem">
    <Setter Property="Background" Value="#202A31" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,5,0" />
  </Style>

  <Style Selector="Border.game-search-ecosystem TextBlock">
    <Setter Property="Foreground" Value="#9FC9BA" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Border.status-bar">
    <Setter Property="Background" Value="#0E1014" />
    <Setter Property="BorderBrush" Value="#242832" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="Border.status-bar TextBlock">
    <Setter Property="Foreground" Value="#858C99" />
  </Style>

  <Style Selector="Button.status-downloads">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,1" />
  </Style>

  <Style Selector="Button.status-downloads:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1B1E25" />
  </Style>

  <Style Selector="Button.status-downloads LucideIcon">
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ProgressBar.status-progress">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="Background" Value="#242832" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.tab-badge">
    <Setter Property="Background" Value="#72C6A5" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.tab-badge TextBlock">
    <Setter Property="Foreground" Value="#0E1014" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.download-hero">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#1E2B30" />
        <GradientStop Offset="1" Color="#1A1D24" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#2C3540" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="22" />
  </Style>

  <Style Selector="TextBlock.download-hero-title">
    <Setter Property="Foreground" Value="#F3F4F6" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.download-title">
    <Setter Property="Foreground" Value="#E4E7EC" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.download-meta">
    <Setter Property="Foreground" Value="#8D94A3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.download-status">
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.download-section">
    <Setter Property="Foreground" Value="#737B8C" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.download-count">
    <Setter Property="Foreground" Value="#9FC9BA" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.download-error">
    <Setter Property="Foreground" Value="#E48A98" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ProgressBar.download-progress">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="#72C6A5" />
    <Setter Property="Background" Value="#262B35" />
  </Style>

  <Style Selector="Border.download-icon">
    <Setter Property="Background" Value="#263640" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.download-icon LucideIcon">
    <Setter Property="Foreground" Value="#9FC9BA" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.download-row">
    <Setter Property="Background" Value="#1B1E25" />
    <Setter Property="BorderBrush" Value="#262A33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.download-row:pointerover">
    <Setter Property="Background" Value="#20242C" />
  </Style>

  <Style Selector="Border.download-row.failed">
    <Setter Property="BorderBrush" Value="#4A2B31" />
  </Style>

  <Style Selector="StackPanel.download-actions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.download-row:pointerover StackPanel.download-actions, Border.download-row:focus-within StackPanel.download-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="LucideIcon.download-ok">
    <Setter Property="Foreground" Value="#72C6A5" />
  </Style>

  <Style Selector="LucideIcon.download-failed">
    <Setter Property="Foreground" Value="#E48A98" />
  </Style>

  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B8BEC9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A2F3A" />
    <Setter Property="Foreground" Value="#F3F4F6" />
  </Style>

  <Style Selector="Button.text-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#8D94A3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Button.text-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#F3F4F6" />
  </Style>

  <Style Selector="Border.cli-scrim">
    <Setter Property="Background" Value="#AA090A0E" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="36" />
  </Style>

  <Style Selector="Border.cli-popup">
    <Setter Property="Background" Value="#1C1F27" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.cli-popup TextBlock">
    <Setter Property="Foreground" Value="#F2F4F8" />
  </Style>

  <Style Selector="TextBox.cli-output">
    <Setter Property="MinHeight" Value="260" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Monospace" />
    <Setter Property="Background" Value="#0C0E12" />
    <Setter Property="Foreground" Value="#DCE1E8" />
    <Setter Property="BorderBrush" Value="#292E38" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</Styles>
