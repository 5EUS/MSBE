<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MSBE</AssemblyName>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>

    <!--
      NativeAOT cannot cross-compile, so every one of these is a real CI runner.
      See docs/12-testing-and-release.md.
    -->
    <PublishAot>true</PublishAot>
    <!--
      No SelfContained here. NativeAOT output is inherently self-contained at publish
      time, and CI passes the self-contained flag explicitly. Setting it at build time makes
      this project unreferenceable from the (framework-dependent) test executable:
      NETSDK1151.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <DaemonExecutableName>msbe-daemon</DaemonExecutableName>
    <DaemonExecutableName Condition="$(RuntimeIdentifier.StartsWith('win'))">msbe-daemon.exe</DaemonExecutableName>
    <DaemonSourcePath>$(MSBuildProjectDirectory)/../../../target/release/$(DaemonExecutableName)</DaemonSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MSBE.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="..\..\..\plans\**\*"
             Link="plans\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Every user-visible string lives in Strings.resx. The generator emits Strings.Name accessors and
      Strings.FormatName(...) methods for placeholders, so no translatable text is concatenated.
    -->
    <EmbeddedResource Update="Resources\Strings.resx" GenerateSource="true" ClassName="MSBE.Desktop.Resources.Strings" EmitFormatMethods="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MSBE.Client/MSBE.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AsyncImageLoader.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Lucide.Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="BuildDaemonForPublish" BeforeTargets="Publish">
    <Exec Command="cargo build --release --package msbe-daemon --bin msbe-daemon"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../.." />
    <Copy SourceFiles="$(DaemonSourcePath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
