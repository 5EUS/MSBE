<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MSBE.Desktop.ViewModels"
        x:Class="MSBE.Desktop.Views.Shell.CliWindow"
        x:DataType="vm:MainViewModel"
        Title="MSBE Command Line"
        Width="720" Height="480"
        MinWidth="480" MinHeight="320">
    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SubmitCliCommand}" />
    </Window.KeyBindings>
    <Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="12">
        <TextBox Classes="cli-output" Text="{Binding CliTranscript}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="msbe status" Text="{Binding CliInput}" />
            <Button Grid.Column="1" Content="Run" Command="{Binding SubmitCliCommand}" />
        </Grid>
    </Grid>
</Window>
