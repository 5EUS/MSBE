<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MSBE.Desktop.ViewModels"
             x:Class="MSBE.Desktop.Views.Pages.SettingsPageView"
             x:DataType="vm:MainViewModel">
    <StackPanel Margin="8" Spacing="16">
        <StackPanel Spacing="3">
            <TextBlock Classes="sectionHeading" Text="Settings" />
            <TextBlock Classes="caption" Text="Preferences and shortcuts for this MSBE installation." />
        </StackPanel>

        <TabControl>
            <TabItem Header="Storage">
                <StackPanel Margin="0,12,0,0" Spacing="6">
                    <TextBlock Classes="field-label" Text="Data folder" />
                    <TextBlock Classes="caption" Text="Instances, journals, profiles and pinned plans, as reported by the daemon." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <SelectableTextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding DataDirectoryText}" />
                        <Button Grid.Column="1"
                                Classes="secondary-button"
                                Command="{Binding OpenDataDirectoryCommand}"
                                ToolTip.Tip="Show the data folder in the file manager">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="FolderOpen" Size="15" StrokeWidth="1.8" />
                                <TextBlock Text="Open data folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Extensions">
                <StackPanel Margin="0,12,0,0" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="field-label" Text="Installed extensions" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Signed pack codecs and provider programs in the extensions folder of the data folder. Each is admitted or refused on its own, so a refused one never stops the others." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Classes="secondary-button"
                                Command="{Binding LoadExtensionsCommand}"
                                ToolTip.Tip="Read the installed extensions again">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="RefreshCw" Size="15" StrokeWidth="1.8" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ExtensionsStatus}" />
                    <ItemsControl ItemsSource="{Binding InstalledExtensions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InstalledExtensionItem">
                                <StackPanel Margin="0,6" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Classes="caption" Text="{Binding Kind}" />
                                        <TextBlock Classes="caption" Text="{Binding Status}" />
                                    </StackPanel>
                                    <SelectableTextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="0,12,0,0" Spacing="6">
                    <TextBlock Classes="field-label" Text="MSBE" />
                    <TextBlock Text="Managed game installations" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="The local daemon owns instance data and deployment history. Game folders remain yours." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
