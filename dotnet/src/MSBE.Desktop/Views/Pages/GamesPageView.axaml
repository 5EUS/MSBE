<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:client="using:MSBE.Client"
             xmlns:vm="using:MSBE.Desktop.ViewModels"
             x:Class="MSBE.Desktop.Views.Pages.GamesPageView"
             x:DataType="vm:MainViewModel">
    <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="3">
            <TextBlock Classes="sectionHeading" Text="Supported games" />
            <TextBlock Classes="caption" Text="Games currently available through the connected daemon." />
        </StackPanel>

        <Grid Grid.Row="1">
            <ListBox Classes="games-list" ItemsSource="{Binding Games}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="client:GameInfo">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="4">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SupportVersion, StringFormat=Support {0}}" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Loaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="ecosystem-badge">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" IsVisible="{Binding IsGamesEmpty}">
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No supported games loaded" />
                <TextBlock Classes="caption" Text="The daemon did not find any game support definitions at startup." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
