<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MSBE.Desktop.ViewModels"
             x:Class="MSBE.Desktop.Views.Pages.InstancesPageView"
             x:DataType="vm:MainViewModel">
  <Grid Margin="8" RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel Spacing="3">
        <TextBlock Classes="sectionHeading" Text="Instances" />
        <TextBlock Classes="caption" Text="Registered installations managed by the local daemon." />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary-button" Content="Refresh" Command="{Binding RefreshInstancesCommand}" />
      <Button Grid.Column="2" Classes="primary-button" Content="Add instance" Command="{Binding AddInstanceCommand}" />
    </Grid>

    <Border Grid.Row="1" Classes="error-banner" IsVisible="{Binding HasInstanceError}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="Instances could not be loaded" />
          <TextBlock Classes="caption" Text="{Binding InstanceError}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Try again" Command="{Binding RefreshInstancesCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="instance-detail-panel">
      <Grid RowDefinitions="Auto,*">
        <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsInstancesLoading}" />
        <Grid Grid.Row="1">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="320"
                      Spacing="6"
                      IsVisible="{Binding !HasSelectedInstance}">
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Choose an instance from the library" />
            <TextBlock Classes="caption" TextAlignment="Center" TextWrapping="Wrap" Text="Select an installation in the left sidebar, or register a new one to begin." />
            <Button Margin="0,8,0,0" HorizontalAlignment="Center" Classes="primary-button" Content="Add instance" Command="{Binding AddInstanceCommand}" />
          </StackPanel>

          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="20" IsVisible="{Binding HasSelectedInstance}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="instance-name" Text="{Binding SelectedInstance}" />
                <TextBlock Classes="caption" Text="{Binding SelectedInstanceRoot}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary-button"
                      Content="Rollback latest"
                      IsEnabled="{Binding CanRollbackLatest}"
                      Command="{Binding RollbackLatestCommand}" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
              <TextBlock Classes="detail-label" Text="GAME" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedGameName}" />
              <TextBlock Grid.Row="1" Classes="detail-label" Text="TARGET" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInstanceTarget}" />
              <TextBlock Grid.Row="2" Classes="detail-label" Text="DEPLOYMENT" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInstanceDeployment}" />
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Mods" />
                  <TextBlock Classes="caption" Text="{Binding Mods.Count, StringFormat={}{0} in this profile}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="detail-label" VerticalAlignment="Center" Text="PROFILE" />
                <StackPanel Grid.Column="2" MinWidth="160" Spacing="2">
                  <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
                  <TextBlock Classes="caption" Text="{Binding SelectedProfileTargetSummary}" />
                </StackPanel>
                <Button Grid.Column="3"
                        Classes="secondary-button"
                        Content="Profiles"
                        Command="{Binding OpenProfileManagerCommand}" />
                <Button Grid.Column="4"
                        Classes="primary-button"
                        Content="Review deployment"
                        Command="{Binding PreviewDeploymentCommand}" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ModSource}" PlaceholderText="Local path, HTTPS URL, or modrinth:project">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddModSourceCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="Dependencies" IsChecked="{Binding AddModWithDependencies}" />
                <Button Grid.Column="2" Classes="secondary-button" Content="Remove selected" Command="{Binding RemoveSelectedModCommand}" />
                <Button Grid.Column="3" Classes="primary-button" Content="Add source" Command="{Binding AddModSourceCommand}" />
              </Grid>

              <Grid Grid.Row="2">
                <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsModsLoading}" />
                <Border Classes="mods-error" IsVisible="{Binding HasModsError}">
                  <TextBlock Classes="caption" Text="{Binding ModsError}" TextWrapping="Wrap" />
                </Border>
              </Grid>

              <Grid Grid.Row="3">
                <ListBox Classes="mods-list" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModListItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="mod-icon" Width="34" Height="34" ToolTip.Tip="Installed mod">
                          <LucideIcon Kind="PackageOpen" Size="18" StrokeWidth="1.8" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                          <TextBlock HorizontalAlignment="Right" Text="{Binding Version}" />
                          <TextBlock Classes="caption" HorizontalAlignment="Right" Text="{Binding Source}" />
                          <TextBlock Classes="caption" HorizontalAlignment="Right" Text="{Binding FileSummary}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="5"
                            IsVisible="{Binding IsModsEmpty}">
                  <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No mods in this profile" />
                  <TextBlock Classes="caption" Text="Added mods will appear here in deployment order." />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
