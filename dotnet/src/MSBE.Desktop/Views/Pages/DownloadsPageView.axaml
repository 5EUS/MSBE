<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:res="using:MSBE.Desktop.Resources"
             xmlns:vm="using:MSBE.Desktop.ViewModels"
             x:Class="MSBE.Desktop.Views.Pages.DownloadsPageView"
             x:DataType="vm:MainViewModel">
    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
                <TextBlock Classes="sectionHeading" Text="{x:Static res:Strings.WorkspaceDownloads}" />
                <TextBlock Classes="download-meta" Text="{Binding DownloadSummary}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary-button"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleDownloadQueuePausedCommand}"
                    AutomationProperties.Name="{Binding DownloadQueueToggleLabel}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <LucideIcon Kind="Pause" Size="15" StrokeWidth="2" IsVisible="{Binding !IsDownloadQueuePaused}" />
                    <LucideIcon Kind="Play" Size="15" StrokeWidth="2" IsVisible="{Binding IsDownloadQueuePaused}" />
                    <TextBlock Text="{Binding DownloadQueueToggleLabel}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding HandoffLink}"
                     PlaceholderText="{x:Static res:Strings.DownloadsPasteALinkAProviderPage}"
                     AutomationProperties.Name="{x:Static res:Strings.DownloadsProviderLink}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SubmitHandoffLinkCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="secondary-button" Command="{Binding SubmitHandoffLinkCommand}" AutomationProperties.Name="{x:Static res:Strings.DownloadsAddLink}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <LucideIcon Kind="ClipboardPaste" Size="15" StrokeWidth="2" />
                    <TextBlock Text="{x:Static res:Strings.DownloadsAddLink}" />
                </StackPanel>
            </Button>
        </Grid>

        <Panel Grid.Row="2">
            <Border Classes="download-row" IsVisible="{Binding IsBrowserOpen}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                    <LucideIcon Kind="Globe" Size="17" StrokeWidth="1.8" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="download-meta"
                               VerticalAlignment="Center"
                               Text="{Binding BrowserSummary}"
                               TextTrimming="CharacterEllipsis" />
                    <ToggleSwitch Grid.Column="2"
                                  OnContent="{x:Static res:Strings.DownloadsAutoAdvance}"
                                  OffContent="{x:Static res:Strings.DownloadsAutoAdvance}"
                                  AutomationProperties.Name="{x:Static res:Strings.DownloadsGoToTheNextPageAfter}"
                                  IsChecked="{Binding IsBrowserAutoAdvancing}"
                                  Command="{Binding SetBrowserAutoAdvanceCommand}" />
                    <Button Grid.Column="3" Classes="secondary-button" Content="{x:Static res:Strings.DownloadsNextPage}" Command="{Binding NextBrowserPageCommand}" />
                    <Button Grid.Column="4" Classes="text-button" Content="{x:Static res:Strings.BrowserClose}" Command="{Binding CloseMsbeBrowserCommand}" />
                </Grid>
            </Border>
            <Button Classes="secondary-button"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding CanOpenWaitingPages}"
                    Command="{Binding NextBrowserPageCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <LucideIcon Kind="Globe" Size="15" StrokeWidth="2" />
                    <TextBlock Text="{x:Static res:Strings.DownloadsOpenWaitingPagesInTheMsbe}" />
                </StackPanel>
            </Button>
        </Panel>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,8" Spacing="26">
                <Border Classes="download-hero">
                    <Panel>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="18" IsVisible="{Binding IsDownloading}">
                            <Border Classes="download-icon" Width="64" Height="64" ClipToBounds="True">
                                <Panel>
                                    <LucideIcon Kind="PackageSearch" Size="26" StrokeWidth="1.6" />
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding ActiveDownload.IconSource}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="download-hero-title" Text="{Binding ActiveDownload.Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="download-meta" Text="{Binding ActiveDownload.Summary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="download-status" VerticalAlignment="Center" Text="{Binding ActiveDownload.StatusText}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Classes="download-progress" IsIndeterminate="True" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding !IsDownloading}">
                            <Border Classes="download-icon" Width="64" Height="64">
                                <Panel>
                                    <LucideIcon Kind="Download" Size="26" StrokeWidth="1.6" IsVisible="{Binding !IsDownloadQueuePaused}" />
                                    <LucideIcon Kind="Pause" Size="26" StrokeWidth="1.6" IsVisible="{Binding IsDownloadQueuePaused}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="download-hero-title" Text="{Binding DownloadIdleTitle}" />
                                <TextBlock Classes="download-meta" Text="{Binding DownloadIdleHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Panel>
                </Border>

                <StackPanel Spacing="10" IsVisible="{Binding HasQueuedDownloads}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="download-section" Text="{x:Static res:Strings.DownloadsUpNext}" />
                        <TextBlock Classes="download-count" Text="{Binding QueuedDownloads.Count}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding QueuedDownloads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadQueueItem">
                                <Border Classes="download-row">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Border Classes="download-icon" Width="36" Height="36" ClipToBounds="True">
                                            <Panel>
                                                <LucideIcon Kind="PackageSearch" Size="17" StrokeWidth="1.8" />
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding IconSource}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="download-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="download-meta" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="download-meta" Text="{Binding Detail}" TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding HasDetail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="download-meta" VerticalAlignment="Center" Text="{Binding StatusText}" />
                                            <Button Classes="secondary-button"
                                                    IsVisible="{Binding NeedsProfile}"
                                                    Content="{x:Static res:Strings.DownloadsAddToSelectedProfile}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddDownloadToProfileCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Classes="download-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Classes="icon-button"
                                                    IsVisible="{Binding IsAwaitingUser}"
                                                    ToolTip.Tip="{x:Static res:Strings.DownloadOpenPageInBrowser}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DownloadOpenPageInBrowser}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenDownloadPageInBrowserCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="ExternalLink" Size="16" StrokeWidth="2" />
                                            </Button>
                                            <Button Classes="icon-button"
                                                    IsVisible="{Binding IsAwaitingUser}"
                                                    ToolTip.Tip="{x:Static res:Strings.DownloadsOpenThePageInTheMsbe}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DownloadsOpenThePageInTheMsbe}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenDownloadPageCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="Globe" Size="16" StrokeWidth="2" />
                                            </Button>
                                            <Button Classes="icon-button"
                                                    ToolTip.Tip="{x:Static res:Strings.DownloadsMoveUp}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DownloadsMoveUp}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveDownloadUpCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="ChevronUp" Size="16" StrokeWidth="2" />
                                            </Button>
                                            <Button Classes="icon-button"
                                                    ToolTip.Tip="{x:Static res:Strings.DownloadsMoveDown}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DownloadsMoveDown}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveDownloadDownCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="ChevronDown" Size="16" StrokeWidth="2" />
                                            </Button>
                                            <Button Classes="icon-button"
                                                    ToolTip.Tip="{x:Static res:Strings.DownloadsRemoveFromQueue}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DownloadsRemoveFromQueue}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveQueuedDownloadCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="X" Size="16" StrokeWidth="2" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="10" IsVisible="{Binding HasFinishedDownloads}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="download-section" Text="{x:Static res:Strings.DownloadsCompleted}" />
                            <TextBlock Classes="download-count" Text="{Binding FinishedDownloads.Count}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="text-button" Content="{x:Static res:Strings.DownloadsClear}" Command="{Binding ClearFinishedDownloadsCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FinishedDownloads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadQueueItem">
                                <Border Classes="download-row" Classes.failed="{Binding IsFailed}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Classes="download-icon" Width="36" Height="36" ClipToBounds="True">
                                            <Panel>
                                                <LucideIcon Kind="PackageSearch" Size="17" StrokeWidth="1.8" />
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding IconSource}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="download-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="download-meta" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="download-error" Text="{Binding Detail}" TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding IsFailed}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="download-meta" VerticalAlignment="Center" Text="{Binding Detail}" IsVisible="{Binding IsCompleted}" />
                                            <LucideIcon Classes="download-ok" Kind="CircleCheck" Size="17" StrokeWidth="2" IsVisible="{Binding IsCompleted}" />
                                            <Button Classes="icon-button"
                                                    IsVisible="{Binding IsFailed}"
                                                    ToolTip.Tip="{x:Static res:Strings.DownloadsRetry}"
                                                    AutomationProperties.Name="{x:Static res:Strings.DownloadsRetryDownload}"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RetryDownloadCommand}"
                                                    CommandParameter="{Binding}">
                                                <LucideIcon Kind="RotateCw" Size="15" StrokeWidth="2" />
                                            </Button>
                                            <LucideIcon Classes="download-failed" Kind="CircleAlert" Size="17" StrokeWidth="2" IsVisible="{Binding IsFailed}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
