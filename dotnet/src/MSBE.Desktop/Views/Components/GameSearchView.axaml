<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:MSBE.Desktop.Resources"
             xmlns:client="using:MSBE.Client"
             xmlns:vm="using:MSBE.Desktop.ViewModels"
             x:Class="MSBE.Desktop.Views.Components.GameSearchView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,200" RowSpacing="8">
        <TextBox Text="{Binding GameSearchText}"
                 PlaceholderText="{x:Static res:Strings.GameSearchSearchGamesOrEcosystems}"
                 AutomationProperties.Name="{x:Static res:Strings.GameSearchSearchSupportedGames}" />

        <Grid Grid.Row="1">
            <ListBox Classes="game-search-list"
                     ItemsSource="{Binding FilteredGames}"
                     SelectedItem="{Binding NewInstanceGame}"
                     AutomationProperties.Name="{x:Static res:Strings.GameSearchSupportedGames}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="client:GameInfo">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="11">
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Loaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="game-search-ecosystem">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Classes="caption"
                                       VerticalAlignment="Center"
                                       Text="{Binding SupportVersion, StringFormat={x:Static res:Strings.GamesSupportVersion}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        IsVisible="{Binding IsGameSearchEmpty}">
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{x:Static res:Strings.GameSearchNoMatchingGames}" />
                <TextBlock Classes="caption" IsVisible="{Binding HasGameSearchText}" Text="{x:Static res:Strings.GameSearchTryAGameNameOrEcosystem}" />
                <TextBlock Classes="caption" IsVisible="{Binding !HasGameSearchText}" Text="{x:Static res:Strings.GameSearchNoGameSupportIsLoadedBy}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
